# 새 기기에서 이 파일을 .env.local 로 복사하고 값을 채운다.
# .env.local 은 .gitignore 에 걸려 있다. 이 파일(example)에는 값을 넣지 말 것.

# ── 없으면 아무것도 안 뜬다 ──────────────────────────────────
# Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://efvcciopdgrqbjlhkfwq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 로컬은 http://localhost:3000, 배포는 https://www.partymoa.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 푸시까지 로컬에서 돌릴 때만 ──────────────────────────────
# 하나라도 비면 알림이 조용히 안 간다. 예매 같은 진짜 일은 안 막힌다.
# 키를 새로 만들면 기존 구독이 전부 죽는다 — Vercel 에 있는 값을 그대로 가져온다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@partymoa.com
# 크론이 push_targets 를 부를 때만 쓴다. 절대 클라이언트로 내보내지 말 것
SUPABASE_SERVICE_ROLE_KEY=
# 비우면 누구나 손님에게 알림을 울릴 수 있다
CRON_SECRET=
