# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 비어 있는 템플릿만 예외 — README 가 이걸 복사하라고 한다
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 손님 개인정보가 든 SQL. **저장소에 올리지 않는다.**
# 이름·전화번호 40여 건이 들어 있어서, 저장소를 누구와 공유하든
# 그 순간 그대로 새어 나간다. 로컬에 두고 SQL Editor 에 붙여 쓴다.
supabase/GUEST_INFO.sql
supabase/gender_fill.html
supabase/IMPORT_GUESTS.sql

# 안드로이드 (TWA)
android/build/
android/app/build/
android/.gradle/
android/local.properties
# **서명 키는 절대 커밋하지 않는다.** 이게 새면 남이 우리 앱 이름으로
# 업데이트를 올릴 수 있다
android/*.keystore
android/*.jks

# 서명 키 비밀번호. 절대 커밋 금지
android/.keypw
android/KEY.txt

# iOS — Xcode 가 다시 만드는 것들
ios/App/build/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/*.xcodeproj/xcuserdata/
ios/App/*.xcworkspace/xcuserdata/
ios/DerivedData/
*.xcuserstate

# 빌드 산출물. 커밋할 이유가 없고 저장소만 무거워진다
store/ios/build/
*.ipa
*.xcarchive
